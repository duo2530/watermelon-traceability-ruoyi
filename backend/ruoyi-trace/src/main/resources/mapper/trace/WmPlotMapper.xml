<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.trace.mapper.WmPlotMapper">

    <resultMap type="WmPlot" id="WmPlotResult">
        <id     property="plotId" column="plot_id" />
        <result property="plotName" column="plot_name" />
        <result property="areaMu" column="area_mu" />
        <result property="address" column="address" />
        <result property="longitude" column="longitude" />
        <result property="latitude" column="latitude" />
        <result property="soilType" column="soil_type" />
        <result property="farmerId" column="farmer_id" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
        <result property="farmerName" column="farmerName" />
    </resultMap>

    <sql id="selectWmPlotVo">
        select p.plot_id, p.plot_name, p.area_mu, p.address, p.longitude, p.latitude, p.soil_type, p.farmer_id, p.status, p.create_by, p.create_time, p.update_by, p.update_time, p.remark, u.nick_name as farmerName
        from wm_plot p
        left join sys_user u on u.user_id = p.farmer_id
    </sql>

    <select id="selectWmPlotList" parameterType="WmPlot" resultMap="WmPlotResult">
        <include refid="selectWmPlotVo"/>
        <where>
            <if test="plotName != null and plotName != ''"> and p.plot_name like concat('%', #{plotName}, '%')</if>
            <if test="address != null and address != ''"> and p.address like concat('%', #{address}, '%')</if>
            <if test="farmerId != null"> and p.farmer_id = #{farmerId}</if>
            <if test="status != null and status != ''"> and p.status = #{status}</if>
        </where>
        order by plot_id desc
    </select>

    <select id="selectWmPlotById" parameterType="Long" resultMap="WmPlotResult">
        <include refid="selectWmPlotVo"/>
        where p.plot_id = #{plotId}
    </select>

    <insert id="insertWmPlot" parameterType="WmPlot" useGeneratedKeys="true" keyProperty="plotId">
        insert into wm_plot
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="plotName != null">plot_name,</if>
            <if test="areaMu != null">area_mu,</if>
            <if test="address != null">address,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="soilType != null">soil_type,</if>
            <if test="farmerId != null">farmer_id,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="plotName != null">#{plotName},</if>
            <if test="areaMu != null">#{areaMu},</if>
            <if test="address != null">#{address},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="soilType != null">#{soilType},</if>
            <if test="farmerId != null">#{farmerId},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateWmPlot" parameterType="WmPlot">
        update wm_plot
        <trim prefix="SET" suffixOverrides=",">
            <if test="plotName != null">plot_name = #{plotName},</if>
            <if test="areaMu != null">area_mu = #{areaMu},</if>
            <if test="address != null">address = #{address},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="soilType != null">soil_type = #{soilType},</if>
            <if test="farmerId != null">farmer_id = #{farmerId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where plot_id = #{plotId}
    </update>

    <delete id="deleteWmPlotById" parameterType="Long">
        delete from wm_plot where plot_id = #{plotId}
    </delete>

    <delete id="deleteWmPlotByIds" parameterType="Long">
        delete from wm_plot where plot_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countBatchByPlotIds" parameterType="Long" resultType="int">
        select count(1) from wm_batch where plot_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
