<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.trace.mapper.WmFarmRecordMapper">

    <resultMap type="WmFarmRecord" id="WmFarmRecordResult">
        <id     property="recordId" column="record_id" />
        <result property="batchId" column="batch_id" />
        <result property="recordType" column="record_type" />
        <result property="content" column="content" />
        <result property="inputName" column="input_name" />
        <result property="inputAmount" column="input_amount" />
        <result property="recordTime" column="record_time" />
        <result property="weather" column="weather" />
        <result property="images" column="images" />
        <result property="operator" column="operator" />
        <result property="clientId" column="client_id" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
        <result property="batchCode" column="batchCode" />
        <result property="farmerId" column="farmerId" />
    </resultMap>

    <sql id="selectWmFarmRecordVo">
        select r.record_id, r.batch_id, r.record_type, r.content, r.input_name, r.input_amount, r.record_time, r.weather, r.images, r.operator, r.client_id, r.create_by, r.create_time, r.update_by, r.update_time, r.remark, b.batch_code as batchCode, b.farmer_id as farmerId
        from wm_farm_record r
        left join wm_batch b on b.batch_id = r.batch_id
    </sql>

    <select id="selectWmFarmRecordList" parameterType="WmFarmRecord" resultMap="WmFarmRecordResult">
        <include refid="selectWmFarmRecordVo"/>
        <where>
            <if test="batchId != null"> and r.batch_id = #{batchId}</if>
            <if test="recordType != null and recordType != ''"> and r.record_type = #{recordType}</if>
            <if test="content != null and content != ''"> and r.content like concat('%', #{content}, '%')</if>
            <if test="farmerId != null"> and b.farmer_id = #{farmerId}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date_format(r.record_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"> and date_format(r.record_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')</if>
        </where>
        order by r.record_time desc, r.record_id desc
    </select>

    <select id="selectWmFarmRecordById" parameterType="Long" resultMap="WmFarmRecordResult">
        <include refid="selectWmFarmRecordVo"/>
        where r.record_id = #{recordId}
    </select>

    <insert id="insertWmFarmRecord" parameterType="WmFarmRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into wm_farm_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="batchId != null">batch_id,</if>
            <if test="recordType != null">record_type,</if>
            <if test="content != null">content,</if>
            <if test="inputName != null">input_name,</if>
            <if test="inputAmount != null">input_amount,</if>
            <if test="recordTime != null">record_time,</if>
            <if test="weather != null">weather,</if>
            <if test="images != null">images,</if>
            <if test="operator != null">operator,</if>
            <if test="clientId != null">client_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="batchId != null">#{batchId},</if>
            <if test="recordType != null">#{recordType},</if>
            <if test="content != null">#{content},</if>
            <if test="inputName != null">#{inputName},</if>
            <if test="inputAmount != null">#{inputAmount},</if>
            <if test="recordTime != null">#{recordTime},</if>
            <if test="weather != null">#{weather},</if>
            <if test="images != null">#{images},</if>
            <if test="operator != null">#{operator},</if>
            <if test="clientId != null">#{clientId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateWmFarmRecord" parameterType="WmFarmRecord">
        update wm_farm_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="batchId != null">batch_id = #{batchId},</if>
            <if test="recordType != null">record_type = #{recordType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="inputName != null">input_name = #{inputName},</if>
            <if test="inputAmount != null">input_amount = #{inputAmount},</if>
            <if test="recordTime != null">record_time = #{recordTime},</if>
            <if test="weather != null">weather = #{weather},</if>
            <if test="images != null">images = #{images},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteWmFarmRecordById" parameterType="Long">
        delete from wm_farm_record where record_id = #{recordId}
    </delete>

    <delete id="deleteWmFarmRecordByIds" parameterType="Long">
        delete from wm_farm_record where record_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectWmFarmRecordByClientId" parameterType="String" resultMap="WmFarmRecordResult">
        <include refid="selectWmFarmRecordVo"/>
        where r.client_id = #{clientId}
    </select>

    <select id="countWmFarmRecordByBatchIds" parameterType="Long" resultType="int">
        select count(1) from wm_farm_record where batch_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
